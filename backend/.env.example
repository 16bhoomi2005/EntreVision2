# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/entrevision

# Data.gov.in API Configuration for Mandi Price Collector
# Get API key from: https://data.gov.in -> My Account -> API key
DATAGOV_API_KEY=your_api_key_here

# Get Resource ID from: https://data.gov.in -> Search "Current Daily Price of Various Commodities from Various Markets (Mandi)" -> API tab
DATAGOV_RESOURCE_ID=your_resource_id_here
